{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dependencies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "source", "requiredBy", "satisfiedBy", "installers"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "pattern": "^https://" },
          "version": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "requiredBy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "satisfiedBy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "installers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requires", "command", "args"],
              "properties": {
                "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["aix", "android", "darwin", "freebsd", "haiku", "linux", "openbsd", "sunos", "win32", "cygwin", "netbsd"] } },
                "requires": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } },
                "versionCheck": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["command", "args", "minimum"],
                  "properties": {
                    "command": { "type": "string", "minLength": 1 },
                    "args": { "type": "array", "items": { "type": "string" } },
                    "minimum": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
