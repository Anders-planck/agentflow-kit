{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "description", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string", "minLength": 1 },
    "detects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode"],
        "properties": {
          "mode": { "enum": ["off", "registered", "auto", "project", "always"] },
          "provider": { "type": "string" },
          "options": { "type": "object" }
        }
      }
    }
  }
}
