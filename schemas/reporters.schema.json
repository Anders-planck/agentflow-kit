{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reporters"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "reporters": {
      "type": "object",
      "required": ["terminal", "json", "markdown", "sarif", "html"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extension", "machineReadable", "selfContained"],
        "properties": {
          "extension": { "type": "string" },
          "machineReadable": { "type": "boolean" },
          "selfContained": { "type": "boolean" }
        }
      }
    }
  }
}
