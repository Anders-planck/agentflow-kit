{
  "name": "agentflow-kit",
  "version": "0.1.0",
  "description": "Public, reversible configuration toolkit for Codex, Claude Code, and OpenCode.",
  "type": "module",
  "bin": {
    "agentflow": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "registry",
    "policies",
    "skills",
    "ast-grep",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:unit": "npm run build && node --test dist/test/unit/*.test.js",
    "check": "npm run build && npm test && node dist/src/cli.js validate --root .",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "codex",
    "claude-code",
    "opencode",
    "agent-skills",
    "mcp",
    "serena",
    "context-mode",
    "ast-grep"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anders-planck/agentflow-kit.git"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
